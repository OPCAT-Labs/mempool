# Copy to a local file outside the repo, fill in real values, then:
#   scripts/create-testnet-env.sh --env-file <path>
# Real hosts/addresses live only in the GitHub environment, never in the repo.

# --- variables ---
DEPLOY_USER=opcat
DEPLOY_DIR=/home/opcat/mempool
DEPLOY_PORT=22
DEPLOY_HOST_NAME=testnet.opcatlabs.io
MEMPOOL_NETWORK=testnet
MEMPOOL_BACKEND=electrum
BACKEND_PORT=8999
FRONTEND_PORT=4200
TRACKER_API=http://127.0.0.1:3000
ELECTRUM_PORT=50006
ELECTRUM_TLS_ENABLED=false
CORE_RPC_PORT=28443
# MariaDB runs in docker on the droplet, published on loopback only
DATABASE_HOST=127.0.0.1
DATABASE_PORT=23306
DATABASE_NAME=mempool
DATABASE_USERNAME=mempool
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=false

# --- secrets ---
DEPLOY_HOST=<droplet-public-ip>
# electrs binds to its droplet's VPC address
ELECTRS_API=http://<electrs-vpc-ip>:3006
ELECTRUM_HOST=<electrs-vpc-ip>
CORE_RPC_HOST=<node-vpc-ip>
CORE_RPC_USERNAME=<rpc-user>
CORE_RPC_PASSWORD=
DATABASE_PASSWORD=
# Private half of the per-droplet CD key; public half goes in /home/opcat/.ssh/authorized_keys
DEPLOY_SSH_KEY_FILE=<path-to-cd-private-key>
